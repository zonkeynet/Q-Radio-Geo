    <Document>
        <name>cita_cameras</name>
        <Style id="camera">
            <IconStyle>
                <Icon><href>https://www.cita.lu/images/kml/cams/cctv_0.png</href></Icon>
                <scale>1.000000</scale>
            </IconStyle>
            <BalloonStyle>
                <text>$[description]</text>
            </BalloonStyle>
            <LabelStyle>
                <color>00000000</color>
                <scale>0.000000</scale>
            </LabelStyle>
            <PolyStyle>
                <color>ff000000</color>
                <outline>0</outline>
            </PolyStyle>
        </Style>               
        <Folder>
            <name>Cameras</name>
            <description>tous les caméras sur www.cita.lu</description>
            
            <Placemark id="camera_3">
                <name>A6 - Camera 3</name>
                <description><![CDATA[<iframe class="cam-frame" src="https://www.cita.lu/webcam/map/3" height="245" width="270" scrolling="no" ></iframe>]]>
